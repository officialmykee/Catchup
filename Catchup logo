<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LINE Logo — Pure HTML/CSS</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans:wght@700;800;900&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 60px;
    background: #f0f0f0;
    font-family: 'Noto Sans', sans-serif;
  }

  /* ── LOGO WRAPPER ── */
  .line-logo {
    position: relative;
    width: 250px;
    height: 250px;

    /* rounded square */
    background: #06C755;
    border-radius: 56px;

    display: flex;
    align-items: center;
    justify-content: center;

    /* subtle shadow like the real icon */
    box-shadow:
      0 12px 40px rgba(6,199,85,0.40),
      0 4px 12px rgba(0,0,0,0.18);

    animation: pop 0.6s cubic-bezier(0.34,1.56,0.64,1) both;
  }

  @keyframes pop {
    from { transform: scale(0.6) rotate(-8deg); opacity: 0; }
    to   { transform: scale(1)   rotate(0deg);  opacity: 1; }
  }

  /* ── SPEECH BUBBLE ── */
  .bubble {
    position: relative;
    width: 172px;
    height: 164px;
    background: #fff;
    border-radius: 50% / 46%;   /* oval-ish, matching LINE's proportions */

    /* push everything up a touch so the tail has visual room */
    margin-bottom: 14px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* tail — the little notch at the bottom-left of the bubble */
  .bubble::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 36px;

    /* two-layer clip to mimic the concave tail */
    width: 34px;
    height: 26px;
    background: #fff;
    clip-path: polygon(0 0, 100% 0, 40% 100%);
  }



  /* ── "LINE" TEXT ── */
  .line-text {
    display: flex;
    align-items: center;
    gap: 0px;
    position: relative;
    z-index: 2;                  /* above the pseudo-element hole */
  }

  .line-text span {
    font-family: 'Noto Sans', sans-serif;
    font-weight: 900;
    font-size: 52px;
    color: #06C755;
    line-height: 1;
    letter-spacing: -1px;
  }


</style>
</head>
<body>

  <!-- Primary large logo -->
  <div class="line-logo">
    <div class="bubble">
      <div class="line-text">
        <span>LINE</span>
      </div>
    </div>
  </div>



</body>
</html>

